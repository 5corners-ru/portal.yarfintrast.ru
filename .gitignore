# Client repo — copied by kit bootstrap (templates/.gitignore.client → .gitignore)

# Secrets and local env
.env
.env.*
.env*
!.env.example

# Local dumps / REST artifacts (may contain PII)
.artifacts/

# Cursor agent cache
.cursor/cache/

# SSH keys (never commit private keys)
.ssh/
*.pem
id_rsa*
id_ed25519*
!*.pub

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Logs and runtime artifacts
*.log
/logs/

# Backups and dumps (may contain PII)
/backups/
*.sql
*.sql.gz
*.tar
*.tar.gz
*.zip

# QA scratch (optional — remove if you commit qa artifacts)
/local/tools/qa-cr*/
